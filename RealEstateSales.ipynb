import time
import requests
import hashlib
from pymongo import MongoClient, errors

API = "https://data.ct.gov/resource/5mzw-sjtu.json"
CHUNK = 50000

client = MongoClient("mongodb://localhost:27017")
col = client.realestate.realestate_raw

def norm(x):
    return "" if x is None else str(x).strip()

def make_id(row):
    # Construimos una clave lógica estable del registro
    key = "|".join([
        norm(row.get("serialnumber")),
        norm(row.get("listyear")),
        norm(row.get("daterecorded")),
        norm(row.get("saleamount")),
        norm(row.get("assessedvalue")),
        norm(row.get("town")),
    ])

    # Convertimos esa clave en un hash SHA1:
    # - encode("utf-8") → convierte el string en bytes
    # - sha1(...) → genera hash
    # - hexdigest() → lo devuelve como string hexadecimal de 40 caracteres
    # Ventaja: _id corto, fijo y más eficiente en índice.
    # No es obligatorio, pero es buena práctica para grandes volúmenes (~1.1M filas).
    return hashlib.sha1(key.encode("utf-8")).hexdigest()

offset = 0
inserted_total = 0

while True:
    params = {"$limit": CHUNK, "$offset": offset}
    r = requests.get(API, params=params, timeout=60)
    r.raise_for_status()
    rows = r.json()
    if not rows:
        break

    docs = []
    for row in rows:
        row["_id"] = make_id(row)
        docs.append(row)

    try:
        res = col.insert_many(docs, ordered=False)
        inserted_total += len(res.inserted_ids)
    except errors.BulkWriteError as e:
        # Inserta los no-duplicados; ignora errores de duplicate key
        inserted_total += e.details.get("nInserted", 0)

    offset += CHUNK
    time.sleep(0.2)

print("Inserted this run:", inserted_total)
print("Total docs in collection:", col.count_documents({}))
